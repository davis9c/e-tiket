
#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
COMPOSE_PROJECT_NAME=etiket-live
CI_ENVIRONMENT = development


#--------------------------------------------------------------------
# Khanza Bridge
#--------------------------------------------------------------------
ROLE_ADMIN = J002
API_KANZA_BRIDGE = 'http://host.docker.internal:8091/api/'
KANZABRIDGE_BASE_URL = 'http://host.docker.internal:8091/api/v2/'
KANZABRIDGE_API_KEY =

# KanzaBridge lokal Docker menggunakan HTTP; production wajib menggunakan HTTPS.
# Override ini hanya untuk HTTP pada setup Docker lokal.
# HAPUS baris ini di .env produksi begitu aplikasi dionlinekan dengan HTTPS.
# Set KANZABRIDGE_REQUIRE_HTTPS=true di production.
KANZABRIDGE_REQUIRE_HTTPS = false

# Port host yang dipetakan ke port 80 container.
APP_PORT=8080




#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Nama aplikasi yang tampil di navbar, judul tab, footer, dan sidenav.
APP_NAME = 'E-Tiket'
app.baseURL = 'http://localhost:8080/'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#-----------------------------------------------------------------------
# COOKIE
#-----------------------------------------------------------------------
# Cookie lokal Docker menggunakan HTTP. Aktifkan di production dengan HTTPS.
# Cookie session pada production wajib memakai HTTPS.
# Nilai `false` di bawah hanya untuk development HTTP.
# Aktifkan secure cookies saat aplikasi menggunakan HTTPS.
cookie.secure = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = host.docker.internal
database.default.database = e_tiket
database.default.username = eticket
database.default.password = eticket
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# PENGINGAT SETUP DATABASE
#--------------------------------------------------------------------
# Setelah database dibuat atau konfigurasi di atas diubah, jalankan:
#   php spark migrate
#   php spark db:seed KategoriEticketSeeder
#
# Jika memakai Docker:
#   docker compose exec app php spark migrate
#   docker compose exec app php spark db:seed KategoriEticketSeeder
#
# PERHATIAN: migrate:refresh akan menghapus seluruh data. Gunakan hanya
# untuk instalasi baru/development.

